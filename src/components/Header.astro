---
import { getCollection } from 'astro:content';
import { site } from '../config';

const notes = (await getCollection('notes')).filter((n) => !n.data.draft);

const nav = [
  { href: '/projects/', label: 'projects' },
  { href: '/publications/', label: 'publications' },
  { href: '/teaching/', label: 'teaching' },
  ...(notes.length ? [{ href: '/notes/', label: 'notes' }] : []),
  { href: '/cv/', label: 'cv' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
      <span class="mark" aria-hidden="true"></span>
      <span>{site.wordmark}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme" data-theme-toggle>
      <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path></svg>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 60px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--text);
    white-space: nowrap;
  }
  .mark {
    width: 10px;
    height: 16px;
    border-radius: 2px;
    background: var(--accent);
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page']::before {
    content: '/';
    color: var(--accent);
    margin-right: 1px;
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    flex: none;
  }
  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  :global([data-theme='dark']) .i-moon,
  :global([data-theme='light']) .i-sun {
    display: none;
  }

  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 0.75rem;
      padding-top: 0.6rem;
    }
    .theme-toggle {
      margin-left: auto;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      padding-bottom: 0.35rem;
    }
    nav li:first-child a {
      padding-left: 0;
    }
  }
</style>
