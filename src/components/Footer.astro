---
import { site } from '../config';
const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="left">
      <span>© {year} {site.name}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>updated {updated}</span>
    </div>
    <ul class="links">
      <li><a href={`mailto:${site.email}`}>email</a></li>
      <li><a href={site.links.scholar} rel="me">scholar</a></li>
      <li><a href={site.links.github} rel="me">github</a></li>
      <li><a href={site.links.linkedin} rel="me">linkedin</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: clamp(3rem, 8vw, 6rem);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.75rem 2.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .left {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .links {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent-strong);
  }
</style>
