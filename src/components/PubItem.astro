---
import { toBibtex, type Publication } from '../data/publications';
import { site } from '../config';

interface Props {
  pub: Publication;
  showProject?: boolean;
  compact?: boolean;
  hideYear?: boolean;
}
const { pub, showProject = true, compact = false, hideYear = false } = Astro.props;
const bib = toBibtex(pub);
const L = pub.links ?? {};
const links = [
  L.pdf && { label: 'pdf', href: L.pdf },
  L.arxiv && { label: 'arXiv', href: L.arxiv },
  L.doi && { label: 'doi', href: L.doi },
  L.publisher && { label: 'publisher', href: L.publisher },
  L.code && { label: 'code', href: L.code },
  L.video && { label: 'video', href: L.video },
  L.demo && { label: 'demo', href: L.demo },
].filter(Boolean) as { label: string; href: string }[];
const isSelf = (a: string) => site.selfNames.includes(a);
---

<article class:list={['pub', { compact }]}>
  <div class="venue mono">
    <span>{pub.venueShort}</span>
    {pub.status !== 'under-review' && !hideYear && <span class="year">{pub.year}</span>}
  </div>
  <div class="main">
    <h3 class="title">
      {showProject && pub.project ? <a href={`/projects/${pub.project}/`}>{pub.title}</a> : pub.title}
    </h3>
    <p class="authors">
      {
        pub.authors.map((a, i) => (
          <>
            {isSelf(a) ? <span class="self">{a}</span> : a}
            {i < pub.authors.length - 1 && (pub.authors[i + 1] === 'et al.' ? ' ' : ', ')}
          </>
        ))
      }
    </p>
    {!compact && pub.status !== 'under-review' && <p class="where">{pub.venue}{pub.volume ? `, ${pub.volume}` : ''}{pub.number ? `(${pub.number})` : ''}{pub.status !== 'under-review' ? `, ${pub.year}` : ''}</p>}
    {
      !compact && (links.length > 0 || bib) && (
        <div class="actions">
          {links.map((l) => (
            <a class="act" href={l.href} rel="noopener">
              {l.label}
            </a>
          ))}
          {bib && (
            <button class="act" type="button" aria-expanded="false" aria-controls={`bib-${pub.id}`} data-bib-toggle>
              bibtex
            </button>
          )}
        </div>
      )
    }
    {
      !compact && bib && (
        <div class="bib-box" id={`bib-${pub.id}`} hidden>
          <pre><code>{bib}</code></pre>
          <button class="copy" type="button" data-copy={bib}>copy</button>
        </div>
      )
    }
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-bib-toggle]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const box = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!box) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      box.hidden = open;
    });
  });
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'select & copy';
      }
      setTimeout(() => (btn.textContent = 'copy'), 1600);
    });
  });
</script>

<style>
  .pub {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--border);
  }
  .pub:first-child {
    border-top: 0;
  }
  .venue {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.75rem;
    color: var(--accent);
    padding-top: 0.2rem;
  }
  .venue .year {
    color: var(--text-faint);
  }
  .title {
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.4;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .authors {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .self {
    color: var(--text);
    font-weight: 560;
  }
  .where {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-style: italic;
    margin-top: 0.1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }
  .act {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.42em 0.6em;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    color: var(--text-muted);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  button.act {
    background: none;
  }
  .act:hover,
  .act[aria-expanded='true'] {
    color: var(--accent-strong);
    border-color: var(--accent-line);
  }
  .bib-box {
    position: relative;
    margin-top: 0.6rem;
  }
  .bib-box pre {
    margin: 0;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--text-muted);
    overflow-x: auto;
  }
  .copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.3em 0.55em;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }
  .copy:hover {
    color: var(--text);
  }
  .compact {
    grid-template-columns: 6.5rem minmax(0, 1fr);
    padding-block: 0.9rem;
  }
  @media (max-width: 600px) {
    .pub,
    .compact {
      grid-template-columns: minmax(0, 1fr);
    }
    .venue {
      flex-direction: row;
      gap: 0.5rem;
    }
  }
</style>
