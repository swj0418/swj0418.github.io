---
// Privacy-friendly "lite" embed: shows a poster; the YouTube player loads only on click.
interface Props {
  id: string;
  title: string;
  start?: number;
}
const { id, title, start } = Astro.props;
const params = new URLSearchParams({ autoplay: '1', rel: '0', ...(start ? { start: String(start) } : {}) });
const embed = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
const poster = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" data-embed={embed}>
  <img src={poster} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
  <button type="button" class="play" aria-label={`Play video: ${title}`}>
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
  </button>
  <span class="label mono">{title}</span>
  <a class="fallback" href={`https://www.youtube.com/watch?v=${id}`}>Watch on YouTube</a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt[data-embed]').forEach((el) => {
    const btn = el.querySelector('button');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.embed ?? '';
      iframe.title = btn.getAttribute('aria-label') ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      el.classList.add('playing');
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    background: #000;
  }
  .yt img,
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .yt img {
    opacity: 0.78;
    transition: opacity 200ms ease;
  }
  .yt:hover img {
    opacity: 0.92;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.35);
    background: rgb(10 10 12 / 0.55);
    backdrop-filter: blur(6px);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease;
  }
  .play:hover {
    transform: scale(1.06);
    background: var(--accent);
    color: #0b0c0e;
  }
  .label {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    right: 0.9rem;
    font-size: 0.75rem;
    color: #fff;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.6);
    pointer-events: none;
  }
  .fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
