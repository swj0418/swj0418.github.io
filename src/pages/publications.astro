---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { publications, pubTypeLabel, type PubType } from '../data/publications';
import { site } from '../config';

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const types = [...new Set(publications.map((p) => p.type))] as PubType[];
---

<Base title="Publications" description="Publications by Sangwon Jeong in IEEE TVCG, IEEE VIS, EuroVis, and more.">
  <header class="page-head wrap">
    <p class="eyebrow">Publications</p>
    <h1>Papers</h1>
    <p class="lede">
      Also on <a href={site.links.scholar}>Google Scholar</a>. BibTeX is available for each paper.
    </p>
    <div class="filters mono" role="group" aria-label="Filter by type">
      <button type="button" data-filter="all" aria-pressed="true">all <span>{publications.length}</span></button>
      {
        types.map((t) => (
          <button type="button" data-filter={t} aria-pressed="false">
            {pubTypeLabel[t].toLowerCase()} <span>{publications.filter((p) => p.type === t).length}</span>
          </button>
        ))
      }
    </div>
  </header>

  <div class="wrap list">
    {
      years.map((y) => (
        <section class="year" data-year={y}>
          <h2 class="y mono">{y}</h2>
          <div class="items">
            {publications
              .filter((p) => p.year === y)
              .map((p) => (
                <div data-type={p.type}>
                  <PubItem pub={p} hideYear />
                </div>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => {
        el.hidden = f !== 'all' && el.dataset.type !== f;
      });
      document.querySelectorAll<HTMLElement>('.year').forEach((sec) => {
        sec.hidden = !sec.querySelector('[data-type]:not([hidden])');
      });
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }
  .filters button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.45em 0.75em;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .filters button span {
    color: var(--text-faint);
    margin-left: 0.2em;
  }
  .filters button[aria-pressed='true'] {
    background: var(--accent-soft);
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .list {
    padding-top: 1rem;
  }
  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .y {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-faint);
    padding-top: 1.2rem;
    position: sticky;
    top: 5rem;
    align-self: start;
  }
  .items > div + div :global(.pub) {
    border-top: 1px solid var(--border);
  }
  .items > div:first-child :global(.pub) {
    border-top: 0;
  }
  @media (max-width: 700px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .y {
      position: static;
      padding-top: 0.5rem;
    }
  }
</style>
