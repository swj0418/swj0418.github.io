---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { education, research, software, skills, type Role } from '../data/cv';
import { publications } from '../data/publications';
import { teaching } from '../data/teaching';

const isSelf = (a: string) => site.selfNames.includes(a);
const underReview = publications.filter((p) => p.status === 'under-review');
const peer = publications.filter((p) => p.status !== 'under-review' && p.type !== 'thesis');
const theses = publications.filter((p) => p.type === 'thesis');
const sections: { title: string; roles: Role[] }[] = [
  { title: 'Research experience', roles: research },
  { title: 'Software & leadership', roles: software },
];
---

<Base title="CV" description="Curriculum vitae of Sangwon Jeong.">
  <header class="page-head wrap">
    <p class="eyebrow">Curriculum vitae</p>
    <div class="head-row">
      <h1>{site.name}</h1>
      <div class="actions">
        <a class="btn primary" href={site.links.cv}>Download PDF</a>
        <button class="btn" type="button" onclick="window.print()">Print</button>
      </div>
    </div>
    <p class="contact mono">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span aria-hidden="true">·</span>
      <a href={site.links.github}>github.com/swj0418</a>
      <span aria-hidden="true">·</span>
      <a href={site.links.linkedin}>linkedin.com/in/top1jeong</a>
    </p>
  </header>

  <div class="wrap cv">
    <section>
      <h2 class="eyebrow">Education</h2>
      <div>
        {
          education.map((e) => (
            <div class="row">
              <div class="main">
                <h3>{e.degree}</h3>
                <p class="org">
                  {e.school}
                  {e.note && <> · {e.note}</>}
                </p>
              </div>
              <div class="when mono">{e.when}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="eyebrow">Publications</h2>
      <div>
        {
          [...underReview, ...peer, ...theses].map((p) => (
            <div class="row pub">
              <div class="main">
                <h3>{p.project ? <a href={`/projects/${p.project}/`}>{p.title}</a> : p.title}</h3>
                <p class="org">
                  {p.authors.map((a, i) => (
                    <>
                      {isSelf(a) ? <strong>{a}</strong> : a}
                      {i < p.authors.length - 1 && (p.authors[i + 1] === 'et al.' ? ' ' : ', ')}
                    </>
                  ))}
                </p>
                {p.status !== 'under-review' && <p class="venue">{p.venue}</p>}
              </div>
              <div class="when mono">{p.status === 'under-review' ? 'under review' : p.year}</div>
            </div>
          ))
        }
      </div>
    </section>

    {
      sections.map((s) => (
        <section>
          <h2 class="eyebrow">{s.title}</h2>
          <div>
            {s.roles.map((r) => (
              <div class="row">
                <div class="main">
                  <h3>
                    {r.title}
                    <span class="at">, {r.org}</span>
                  </h3>
                  <ul>
                    {r.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
                <div class="when mono">{r.when}</div>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section>
      <h2 class="eyebrow">Teaching</h2>
      <div>
        {
          teaching.map((t) => (
            <div class="row">
              <div class="main">
                <h3>
                  {t.role}
                  <span class="at">, {t.course}{t.code ? ` (${t.code})` : ''}</span>
                </h3>
                <p class="org">{t.institution}{t.instructor ? ` · Instructor: ${t.instructor}` : ''}</p>
              </div>
              <div class="when mono">{t.term}</div>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="eyebrow">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt class="mono">{s.area}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>

<style>
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .actions {
    display: flex;
    gap: 0.5rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .contact a {
    text-decoration: none;
  }
  .cv section {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .cv section > h2 {
    padding-top: 0.2rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1.5rem;
    padding-block: 0.8rem;
  }
  .row:first-child {
    padding-top: 0;
  }
  .row + .row {
    border-top: 1px dashed var(--border);
  }
  h3 {
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.4;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .at {
    font-weight: 400;
    color: var(--text-muted);
  }
  .org {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 0.2rem;
  }
  .org strong {
    color: var(--text);
    font-weight: 560;
  }
  .venue {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-style: italic;
  }
  .when {
    font-size: 0.75rem;
    color: var(--text-faint);
    white-space: nowrap;
    padding-top: 0.2rem;
    text-align: right;
  }
  ul {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.93rem;
  }
  li + li {
    margin-top: 0.35rem;
  }
  li::marker {
    color: var(--text-faint);
  }
  .skills {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .skills div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .skills dt {
    font-size: 0.78rem;
    color: var(--text-faint);
    padding-top: 0.15rem;
  }
  .skills dd {
    margin: 0;
    color: var(--text-muted);
  }
  @media (max-width: 760px) {
    .cv section {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .when {
      text-align: left;
      order: -1;
      padding-top: 0;
    }
    .skills div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    .actions {
      display: none !important;
    }
  }
</style>
